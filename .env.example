# Copia este archivo a .env y rellena los valores

# OBLIGATORIO en producción: genera uno seguro con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esto-por-una-clave-aleatoria-segura

# "production" activa cookies seguras (HTTPS) y oculta detalles de errores
NODE_ENV=development

# Puerto del servidor (por defecto: 3000)
PORT=3000
