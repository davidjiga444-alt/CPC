<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Instalación · MyCMS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body {
      font-family: 'DM Sans', sans-serif;
      background: linear-gradient(135deg, #0f1117 0%, #1a1f2e 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .setup-wrap { width: 100%; max-width: 560px; }
    .setup-header { text-align: center; margin-bottom: 32px; }
    .brand-icon {
      width: 52px; height: 52px; background: #6366f1;
      border-radius: 14px; display: flex; align-items: center;
      justify-content: center; font-size: 1.5rem; color: white;
      font-weight: 700; margin: 0 auto 14px;
    }
    .setup-header h1 { color: #fff; font-size: 1.6rem; font-weight: 700; margin-bottom: 6px; }
    .setup-header p { color: rgba(255,255,255,0.5); font-size: 0.9rem; }
    .setup-card { background: #fff; border-radius: 14px; padding: 32px; }
    .section-title {
      font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: #6b7280; margin: 20px 0 12px;
      padding-bottom: 8px; border-bottom: 1px solid #f3f4f6;
    }
    .section-title:first-child { margin-top: 0; }
    .form-label { font-weight: 500; font-size: 0.875rem; }
    .form-control {
      border-radius: 8px; font-size: 0.9rem;
      padding: 10px 14px; border: 1px solid #e5e7eb;
    }
    .form-control:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.12); }
    .form-text { font-size: 0.78rem; color: #9ca3af; }
    .btn-install {
      background: #6366f1; border: none; color: white;
      border-radius: 9px; padding: 12px 28px; font-weight: 600;
      font-size: 0.95rem; width: 100%; cursor: pointer;
      transition: background 0.15s;
    }
    .btn-install:hover { background: #4f46e5; }
    .alert { border-radius: 8px; font-size: 0.875rem; }
    .req-check { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #6b7280; margin-bottom: 6px; }
    .req-check i { color: #22c55e; }
  </style>
</head>
<body>
  <div class="setup-wrap">
    <div class="setup-header">
      <div class="brand-icon">M</div>
      <h1>Instalar MyCMS</h1>
      <p>Configura tu nuevo CMS en menos de un minuto</p>
    </div>

    <div class="setup-card">
      <!-- Requirements check -->
      <div class="section-title">Requisitos del sistema</div>
      <div class="req-check"><i class="bi bi-check-circle-fill"></i>Node.js detectado</div>
      <div class="req-check"><i class="bi bi-check-circle-fill"></i>SQLite disponible</div>
      <div class="req-check"><i class="bi bi-check-circle-fill"></i>Directorio de escritura OK</div>

      <% if (error) { %>
        <div class="alert alert-danger mt-3"><i class="bi bi-exclamation-circle me-2"></i><%= error %></div>
      <% } %>

      <form method="POST" action="/setup">
        <!-- Site config -->
        <div class="section-title" style="margin-top:24px;">Configuración del sitio</div>
        <div class="mb-3">
          <label class="form-label" for="site_title">Nombre del sitio <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="site_title" name="site_title"
            value="<%= body && body.site_title ? body.site_title : '' %>"
            placeholder="Mi sitio web" required>
        </div>
        <div class="mb-3">
          <label class="form-label" for="site_description">Descripción</label>
          <input type="text" class="form-control" id="site_description" name="site_description"
            value="<%= body && body.site_description ? body.site_description : '' %>"
            placeholder="Una breve descripción del sitio">
        </div>
        <div class="mb-3">
          <label class="form-label" for="site_url">URL del sitio</label>
          <input type="url" class="form-control" id="site_url" name="site_url"
            value="<%= body && body.site_url ? body.site_url : '' %>"
            placeholder="https://misitioweb.com">
          <div class="form-text">Déjalo vacío si no lo sabes aún</div>
        </div>

        <!-- Admin account -->
        <div class="section-title">Cuenta de administrador</div>
        <div class="mb-3">
          <label class="form-label" for="admin_username">Nombre de usuario <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="admin_username" name="admin_username"
            value="<%= body && body.admin_username ? body.admin_username : '' %>"
            placeholder="admin" required>
        </div>
        <div class="mb-3">
          <label class="form-label" for="admin_email">Email <span class="text-danger">*</span></label>
          <input type="email" class="form-control" id="admin_email" name="admin_email"
            value="<%= body && body.admin_email ? body.admin_email : '' %>"
            placeholder="admin@ejemplo.com" required>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-6">
            <label class="form-label" for="admin_password">Contraseña <span class="text-danger">*</span></label>
            <input type="password" class="form-control" id="admin_password" name="admin_password"
              placeholder="Mínimo 8 caracteres" required minlength="8">
          </div>
          <div class="col-6">
            <label class="form-label" for="admin_password_confirm">Repetir contraseña</label>
            <input type="password" class="form-control" id="admin_password_confirm" name="admin_password_confirm"
              placeholder="Repite la contraseña" required>
          </div>
        </div>

        <button type="submit" class="btn-install mt-2">
          <i class="bi bi-rocket-takeoff me-2"></i>Instalar MyCMS
        </button>
      </form>
    </div>
  </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
