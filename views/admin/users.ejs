<%- include('./partials/head', { pageTitle: 'Usuarios' }) %>
<body>
<%- include('./partials/sidebar', { path: '/admin/users', user: user }) %>

<div class="main-content">
  <div class="topbar">
    <span class="topbar-title">Usuarios</span>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newUserModal">
      <i class="bi bi-plus-lg me-1"></i>Nuevo usuario
    </button>
  </div>

  <div class="page-body">
    <% const errorMsg = messages && messages.error && messages.error.length ? messages.error[0] : null %>
    <% const successMsg = messages && messages.success && messages.success.length ? messages.success[0] : null %>
    <% if (errorMsg) { %><div class="alert alert-danger mb-3"><%= errorMsg %></div><% } %>
    <% if (successMsg) { %><div class="alert alert-success mb-3"><%= successMsg %></div><% } %>

    <div class="card">
      <div class="card-body p-0">
        <% if (users && users.length > 0) { %>
        <table class="table table-hover mb-0">
          <thead><tr>
            <th style="padding-left:18px;">Usuario</th>
            <th>Email</th>
            <th>Rol</th>
            <th>Entradas</th>
            <th>Registro</th>
            <th>Acciones</th>
          </tr></thead>
          <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td style="padding-left:18px;">
                <div class="d-flex align-items-center gap-2">
                  <div style="width:32px;height:32px;border-radius:50%;background:#6366f1;display:flex;align-items:center;justify-content:center;color:white;font-size:0.75rem;font-weight:600;flex-shrink:0;">
                    <%= u.username[0].toUpperCase() %>
                  </div>
                  <span style="font-weight:500;"><%= u.username %></span>
                  <% if (u.id === user.id) { %><span class="badge" style="background:#ede9fe;color:#6d28d9;font-size:0.65rem;">Tú</span><% } %>
                </div>
              </td>
              <td style="color:#6b7280;font-size:0.875rem;"><%= u.email %></td>
              <td>
                <span class="badge" style="background:<%= u.role === 'admin' ? '#fef3c7' : '#f3f4f6' %>;color:<%= u.role === 'admin' ? '#92400e' : '#374151' %>;">
                  <%= u.role %>
                </span>
              </td>
              <td style="color:#6b7280;"><%= u.post_count || 0 %></td>
              <td style="color:#6b7280;font-size:0.8rem;white-space:nowrap;"><%= new Date(u.created_at).toLocaleDateString('es-ES') %></td>
              <td>
                <% if (u.id !== user.id) { %>
                <form method="POST" action="/admin/users/<%= u.id %>?_method=DELETE"
                  onsubmit="return confirm('¿Eliminar usuario <%= u.username %>?')">
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
                <% } else { %>
                  <a href="/admin/profile" class="btn btn-sm btn-outline-secondary"><i class="bi bi-person"></i></a>
                <% } %>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
        <% } else { %>
          <div style="padding:48px;text-align:center;color:#9ca3af;">No hay usuarios.</div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- New user modal -->
<div class="modal fade" id="newUserModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content" style="border-radius:12px;">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-600">Nuevo usuario</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/admin/users">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Nombre de usuario <span class="text-danger">*</span></label>
            <input type="text" name="username" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email <span class="text-danger">*</span></label>
            <input type="email" name="email" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Contraseña <span class="text-danger">*</span></label>
            <input type="password" name="password" class="form-control" required minlength="8">
          </div>
          <div class="mb-3">
            <label class="form-label">Rol</label>
            <select name="role" class="form-select">
              <option value="editor">Editor</option>
              <option value="admin">Administrador</option>
            </select>
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Crear usuario</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
