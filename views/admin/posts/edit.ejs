<%- include('../partials/head', { pageTitle: post && post.id ? 'Editar entrada' : 'Nueva entrada' }) %>
<body>
<%- include('../partials/sidebar', { path: '/admin/posts', user: user }) %>

<div class="main-content">
  <div class="topbar">
    <div class="d-flex align-items-center gap-2">
      <a href="/admin/posts" style="color:#6b7280;text-decoration:none;font-size:0.9rem;"><i class="bi bi-arrow-left me-1"></i>Entradas</a>
      <span style="color:#d1d5db;">/</span>
      <span class="topbar-title"><%= post && post.id ? 'Editar' : 'Nueva entrada' %></span>
    </div>
    <div class="d-flex gap-2">
      <% if (post && post.id && post.status === 'published') { %>
        <a href="/post/<%= post.slug %>" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye me-1"></i>Ver</a>
      <% } %>
      <button type="submit" form="post-form" name="status" value="draft" class="btn btn-sm btn-outline-secondary">Guardar borrador</button>
      <button type="submit" form="post-form" name="status" value="published" class="btn btn-primary btn-sm">Publicar</button>
    </div>
  </div>

  <div class="page-body">
    <% const errorMsg = flash && flash.error && flash.error.length ? flash.error[0] : null %>
    <% if (errorMsg) { %><div class="alert alert-danger mb-3"><%= errorMsg %></div><% } %>

    <form method="POST" id="post-form"
      action="<%= post && post.id ? '/admin/posts/'+post.id+'?_method=PUT' : '/admin/posts' %>">

      <div class="row g-4">
        <!-- Main column -->
        <div class="col-lg-8">
          <div class="card mb-3">
            <div class="card-body">
              <div class="mb-3">
                <input type="text" name="title" id="title" class="form-control"
                  style="font-size:1.2rem;font-weight:600;border:none;padding:0;border-radius:0;box-shadow:none;"
                  placeholder="Título de la entrada"
                  value="<%= post ? post.title : '' %>" required>
                <hr style="margin:12px 0 8px;">
                <div style="font-size:0.8rem;color:#9ca3af;">
                  Enlace: /post/<span id="slug-preview"><%= post ? post.slug : '' %></span>
                </div>
              </div>
              <input type="hidden" name="slug" id="slug" value="<%= post ? post.slug : '' %>">
            </div>
          </div>

          <div class="card mb-3">
            <div class="card-header">Contenido</div>
            <div class="card-body p-0">
              <textarea id="editor" name="content" style="width:100%;min-height:380px;padding:16px;border:none;font-family:'DM Sans',sans-serif;font-size:0.95rem;resize:vertical;outline:none;"><%= post ? post.content : '' %></textarea>
            </div>
          </div>

          <div class="card">
            <div class="card-header">Extracto</div>
            <div class="card-body">
              <textarea name="excerpt" class="form-control" rows="3" placeholder="Breve resumen de la entrada (opcional)"><%= post ? post.excerpt : '' %></textarea>
            </div>
          </div>
        </div>

        <!-- Sidebar column -->
        <div class="col-lg-4">
          <!-- Categories -->
          <div class="card mb-3">
            <div class="card-header">Categorías</div>
            <div class="card-body" style="max-height:200px;overflow-y:auto;">
              <% if (categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="categories" value="<%= cat.id %>"
                      id="cat-<%= cat.id %>"
                      <%= postCategories && postCategories.includes(cat.id) ? 'checked' : '' %>>
                    <label class="form-check-label" for="cat-<%= cat.id %>" style="font-size:0.875rem;"><%= cat.name %></label>
                  </div>
                <% }) %>
              <% } else { %>
                <span style="font-size:0.85rem;color:#9ca3af;">No hay categorías. <a href="/admin/categories">Crear</a></span>
              <% } %>
            </div>
          </div>

          <!-- Featured image -->
          <div class="card mb-3">
            <div class="card-header">Imagen destacada</div>
            <div class="card-body">
              <input type="text" name="featured_image" class="form-control form-control-sm" placeholder="/uploads/imagen.jpg"
                value="<%= post && post.featured_image ? post.featured_image : '' %>">
              <% if (post && post.featured_image) { %>
                <img src="<%= post.featured_image %>" class="mt-2 img-fluid" style="border-radius:6px;">
              <% } %>
            </div>
          </div>

          <!-- Meta -->
          <div class="card">
            <div class="card-header">SEO / Meta</div>
            <div class="card-body">
              <div class="mb-2">
                <label class="form-label">Meta descripción</label>
                <textarea name="meta_description" class="form-control form-control-sm" rows="2"><%= post && post.meta_description ? post.meta_description : '' %></textarea>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Auto-generate slug from title (only on new posts)
  const titleInput = document.getElementById('title');
  const slugInput = document.getElementById('slug');
  const slugPreview = document.getElementById('slug-preview');
  const isNew = !<%= post && post.id ? 'false' : 'true' %>;

  function slugify(text) {
    return text.toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9\s-]/g, '')
      .trim().replace(/\s+/g, '-');
  }

  if (isNew) {
    titleInput.addEventListener('input', () => {
      const slug = slugify(titleInput.value);
      slugInput.value = slug;
      slugPreview.textContent = slug;
    });
  }
</script>
</body>
</html>
