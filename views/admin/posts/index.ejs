<%- include('../partials/head', { pageTitle: 'Entradas' }) %>
<body>
<%- include('../partials/sidebar', { path: '/admin/posts', user: user }) %>

<div class="main-content">
  <div class="topbar">
    <span class="topbar-title">Entradas</span>
    <a href="/admin/posts/new" class="btn btn-primary btn-sm">
      <i class="bi bi-plus-lg me-1"></i>Nueva entrada
    </a>
  </div>

  <div class="page-body">
    <% const errorMsg = messages && messages.error && messages.error.length ? messages.error[0] : null %>
    <% const successMsg = messages && messages.success && messages.success.length ? messages.success[0] : null %>
    <% if (errorMsg) { %><div class="alert alert-danger mb-3"><%= errorMsg %></div><% } %>
    <% if (successMsg) { %><div class="alert alert-success mb-3"><%= successMsg %></div><% } %>

    <!-- Filter bar -->
    <div class="d-flex gap-2 mb-3 align-items-center">
      <form method="GET" action="/admin/posts" class="d-flex gap-2 flex-grow-1">
        <input type="text" name="search" value="<%= search || '' %>" class="form-control form-control-sm" placeholder="Buscar entradas..." style="max-width:260px;">
        <select name="status" class="form-select form-select-sm" style="max-width:150px;">
          <option value="">Todos</option>
          <option value="published" <%= filterStatus === 'published' ? 'selected' : '' %>>Publicados</option>
          <option value="draft" <%= filterStatus === 'draft' ? 'selected' : '' %>>Borradores</option>
        </select>
        <button type="submit" class="btn btn-sm btn-outline-secondary">Filtrar</button>
      </form>
    </div>

    <div class="card">
      <div class="card-body p-0">
        <% if (posts && posts.length > 0) { %>
        <table class="table table-hover mb-0">
          <thead><tr>
            <th style="padding-left:18px;">Título</th>
            <th>Estado</th>
            <th>Categorías</th>
            <th>Autor</th>
            <th>Fecha</th>
            <th>Acciones</th>
          </tr></thead>
          <tbody>
          <% posts.forEach(post => { %>
            <tr>
              <td style="padding-left:18px;">
                <div style="font-weight:500;"><%= post.title %></div>
                <div style="font-size:0.75rem;color:#9ca3af;">/post/<%= post.slug %></div>
              </td>
              <td><span class="badge badge-<%= post.status %>"><%= post.status === 'published' ? 'Publicado' : 'Borrador' %></span></td>
              <td style="font-size:0.8rem;color:#6b7280;"><%= post.categories || '—' %></td>
              <td style="color:#6b7280;font-size:0.85rem;"><%= post.username || '—' %></td>
              <td style="color:#6b7280;font-size:0.8rem;white-space:nowrap;"><%= new Date(post.created_at).toLocaleDateString('es-ES') %></td>
              <td>
                <div class="d-flex gap-1">
                  <a href="/admin/posts/<%= post.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></a>
                  <% if (post.status === 'published') { %>
                    <a href="/post/<%= post.slug %>" target="_blank" class="btn btn-sm btn-outline-secondary" title="Ver"><i class="bi bi-eye"></i></a>
                  <% } %>
                  <form method="POST" action="/admin/posts/<%= post.id %>?_method=DELETE" onsubmit="return confirm('¿Eliminar esta entrada?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
        <% } else { %>
          <div style="padding:48px;text-align:center;color:#9ca3af;">
            <i class="bi bi-file-earmark-text" style="font-size:2.5rem;display:block;margin-bottom:10px;"></i>
            No hay entradas todavía.<br>
            <a href="/admin/posts/new" class="btn btn-primary btn-sm mt-3">Crear primera entrada</a>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Pagination -->
    <% if (pages > 1) { %>
    <nav class="mt-3">
      <ul class="pagination pagination-sm justify-content-center">
        <% for(let i = 1; i <= pages; i++) { %>
          <li class="page-item <%= i === page ? 'active' : '' %>">
            <a class="page-link" href="/admin/posts?page=<%= i %><%= search ? '&search='+search : '' %><%= filterStatus ? '&status='+filterStatus : '' %>"><%= i %></a>
          </li>
        <% } %>
      </ul>
    </nav>
    <% } %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
