<%- include('../partials/head', { pageTitle: 'Páginas' }) %>
<body>
<%- include('../partials/sidebar', { path: '/admin/pages', user: user }) %>

<div class="main-content">
  <div class="topbar">
    <span class="topbar-title">Páginas</span>
    <a href="/admin/pages/new" class="btn btn-primary btn-sm">
      <i class="bi bi-plus-lg me-1"></i>Nueva página
    </a>
  </div>

  <div class="page-body">
    <% const errorMsg = flash && flash.error && flash.error.length ? flash.error[0] : null %>
    <% const successMsg = flash && flash.success && flash.success.length ? flash.success[0] : null %>
    <% if (errorMsg) { %><div class="alert alert-danger mb-3"><%= errorMsg %></div><% } %>
    <% if (successMsg) { %><div class="alert alert-success mb-3"><%= successMsg %></div><% } %>

    <div class="card">
      <div class="card-body p-0">
        <% if (pages && pages.length > 0) { %>
        <table class="table table-hover mb-0">
          <thead><tr>
            <th style="padding-left:18px;">Título</th>
            <th>Estado</th>
            <th>Autor</th>
            <th>Fecha</th>
            <th>Acciones</th>
          </tr></thead>
          <tbody>
          <% pages.forEach(page => { %>
            <tr>
              <td style="padding-left:18px;">
                <div style="font-weight:500;"><%= page.title %></div>
                <div style="font-size:0.75rem;color:#9ca3af;">/page/<%= page.slug %></div>
              </td>
              <td><span class="badge badge-<%= page.status %>"><%= page.status === 'published' ? 'Publicada' : 'Borrador' %></span></td>
              <td style="color:#6b7280;font-size:0.85rem;"><%= page.username || '—' %></td>
              <td style="color:#6b7280;font-size:0.8rem;white-space:nowrap;"><%= new Date(page.created_at).toLocaleDateString('es-ES') %></td>
              <td>
                <div class="d-flex gap-1">
                  <a href="/admin/pages/<%= page.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></a>
                  <% if (page.status === 'published') { %>
                    <a href="/page/<%= page.slug %>" target="_blank" class="btn btn-sm btn-outline-secondary" title="Ver"><i class="bi bi-eye"></i></a>
                  <% } %>
                  <form method="POST" action="/admin/pages/<%= page.id %>?_method=DELETE" onsubmit="return confirm('¿Eliminar esta página?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
        <% } else { %>
          <div style="padding:48px;text-align:center;color:#9ca3af;">
            <i class="bi bi-file-earmark" style="font-size:2.5rem;display:block;margin-bottom:10px;"></i>
            No hay páginas todavía.<br>
            <a href="/admin/pages/new" class="btn btn-primary btn-sm mt-3">Crear primera página</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
