<%- include('./partials/head', { pageTitle: 'Mi perfil' }) %>
<body>
<%- include('./partials/sidebar', { path: '/admin/profile', user: user }) %>

<div class="main-content">
  <div class="topbar">
    <span class="topbar-title">Mi perfil</span>
    <button type="submit" form="profile-form" class="btn btn-primary btn-sm">Guardar cambios</button>
  </div>

  <div class="page-body">
    <% const errorMsg = flash && flash.error && flash.error.length ? flash.error[0] : null %>
    <% const successMsg = flash && flash.success && flash.success.length ? flash.success[0] : null %>
    <% if (errorMsg) { %><div class="alert alert-danger mb-4"><%= errorMsg %></div><% } %>
    <% if (successMsg) { %><div class="alert alert-success mb-4"><%= successMsg %></div><% } %>

    <div class="row g-4">
      <div class="col-lg-8">

        <form method="POST" action="/admin/profile" id="profile-form">
          <!-- Account info -->
          <div class="card mb-4">
            <div class="card-header">Información de cuenta</div>
            <div class="card-body">
              <div class="mb-3">
                <label class="form-label">Nombre de usuario</label>
                <input type="text" class="form-control" value="<%= user ? user.username : '' %>" disabled style="background:#f9fafb;color:#6b7280;">
                <div class="form-text">El nombre de usuario no se puede cambiar.</div>
              </div>
              <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" value="<%= user ? user.email : '' %>" required>
              </div>
            </div>
          </div>

          <!-- Change password -->
          <div class="card">
            <div class="card-header">Cambiar contraseña</div>
            <div class="card-body">
              <div class="mb-3">
                <label class="form-label">Contraseña actual</label>
                <input type="password" name="current_password" class="form-control" placeholder="Déjalo vacío si no la cambias">
              </div>
              <div class="row g-3">
                <div class="col-6">
                  <label class="form-label">Nueva contraseña</label>
                  <input type="password" name="new_password" class="form-control" placeholder="Mínimo 8 caracteres" minlength="8">
                </div>
                <div class="col-6">
                  <label class="form-label">Repetir nueva contraseña</label>
                  <input type="password" name="new_password_confirm" class="form-control" placeholder="Repite la contraseña">
                </div>
              </div>
              <div class="form-text mt-2">Solo rellena si quieres cambiar la contraseña.</div>
            </div>
          </div>
        </form>

      </div>

      <div class="col-lg-4">
        <div class="card">
          <div class="card-body" style="text-align:center;padding:28px;">
            <div style="width:72px;height:72px;border-radius:50%;background:#6366f1;display:flex;align-items:center;justify-content:center;font-size:2rem;color:white;font-weight:700;margin:0 auto 14px;">
              <%= user && user.username ? user.username[0].toUpperCase() : 'U' %>
            </div>
            <div style="font-weight:600;font-size:1.1rem;"><%= user ? user.username : '' %></div>
            <div style="color:#6b7280;font-size:0.875rem;margin-bottom:4px;"><%= user ? user.email : '' %></div>
            <span class="badge" style="background:#ede9fe;color:#6d28d9;"><%= user ? user.role : '' %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
