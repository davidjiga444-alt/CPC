<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= siteTitle || 'MyCMS' %></title>
  <meta name="description" content="<%= siteDescription || '' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root { --accent: #6366f1; --text: #111827; --muted: #6b7280; --border: #e5e7eb; --surface: #f9fafb; }
    * { box-sizing: border-box; }
    body { font-family: 'DM Sans', sans-serif; color: var(--text); margin: 0; background: #fff; }

    /* Header */
    .site-header {
      border-bottom: 1px solid var(--border);
      padding: 0 0;
      position: sticky; top: 0; background: rgba(255,255,255,0.95);
      backdrop-filter: blur(8px); z-index: 100;
    }
    .header-inner {
      max-width: 1100px; margin: 0 auto; padding: 14px 24px;
      display: flex; align-items: center; justify-content: space-between; gap: 20px;
    }
    .site-name {
      font-size: 1.15rem; font-weight: 700; color: var(--text);
      text-decoration: none; letter-spacing: -0.02em;
    }
    .site-nav { display: flex; gap: 4px; align-items: center; flex-wrap: wrap; }
    .site-nav a {
      color: var(--muted); text-decoration: none; font-size: 0.875rem;
      font-weight: 500; padding: 5px 10px; border-radius: 6px; transition: all 0.15s;
    }
    .site-nav a:hover { color: var(--text); background: var(--surface); }
    .search-form { display: flex; gap: 6px; }
    .search-input {
      border: 1px solid var(--border); border-radius: 7px;
      padding: 6px 12px; font-size: 0.85rem; font-family: inherit;
      outline: none; width: 180px; transition: border 0.15s;
    }
    .search-input:focus { border-color: var(--accent); }
    .search-btn {
      background: var(--accent); color: white; border: none;
      border-radius: 7px; padding: 6px 12px; cursor: pointer; font-size: 0.85rem;
    }

    /* Hero (first post) */
    .hero {
      max-width: 1100px; margin: 48px auto 0; padding: 0 24px;
    }
    .hero-card {
      border-radius: 14px; overflow: hidden; background: var(--surface);
      border: 1px solid var(--border); display: flex; gap: 0;
    }
    .hero-image { width: 48%; flex-shrink: 0; min-height: 320px; background: #e5e7eb; overflow: hidden; }
    .hero-image img { width: 100%; height: 100%; object-fit: cover; }
    .hero-image-placeholder {
      width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
      font-size: 4rem; color: #d1d5db; background: linear-gradient(135deg,#f3f4f6,#e9eaf0);
    }
    .hero-body { padding: 36px 36px; display: flex; flex-direction: column; justify-content: center; }
    .hero-meta { font-size: 0.78rem; color: var(--muted); margin-bottom: 12px; }
    .hero-title {
      font-family: 'DM Serif Display', serif;
      font-size: 1.9rem; line-height: 1.2; margin-bottom: 14px; color: var(--text);
      text-decoration: none; display: block;
    }
    .hero-title:hover { color: var(--accent); }
    .hero-excerpt { color: var(--muted); font-size: 0.95rem; line-height: 1.65; margin-bottom: 20px; }
    .read-more {
      color: var(--accent); font-weight: 600; font-size: 0.875rem;
      text-decoration: none; display: inline-flex; align-items: center; gap: 4px;
    }
    .read-more:hover { gap: 8px; }

    /* Posts grid */
    .posts-section { max-width: 1100px; margin: 48px auto; padding: 0 24px; }
    .section-label {
      font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--muted);
      padding-bottom: 14px; border-bottom: 1px solid var(--border); margin-bottom: 24px;
    }
    .posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
    .post-card {
      border: 1px solid var(--border); border-radius: 12px; overflow: hidden;
      background: #fff; transition: box-shadow 0.2s, transform 0.2s;
    }
    .post-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.07); transform: translateY(-2px); }
    .post-card-image { height: 190px; background: var(--surface); overflow: hidden; }
    .post-card-image img { width: 100%; height: 100%; object-fit: cover; }
    .post-card-image-placeholder {
      width: 100%; height: 100%; display: flex; align-items: center;
      justify-content: center; font-size: 3rem; color: #d1d5db;
      background: linear-gradient(135deg,#f3f4f6,#e9eaf0);
    }
    .post-card-body { padding: 18px 20px 20px; }
    .post-card-meta { font-size: 0.75rem; color: var(--muted); margin-bottom: 8px; }
    .post-card-title {
      font-size: 1rem; font-weight: 600; line-height: 1.35;
      margin-bottom: 8px; text-decoration: none; color: var(--text); display: block;
    }
    .post-card-title:hover { color: var(--accent); }
    .post-card-excerpt { font-size: 0.85rem; color: var(--muted); line-height: 1.6; margin: 0; }

    /* Sidebar */
    .layout { max-width: 1100px; margin: 0 auto 60px; padding: 0 24px; display: flex; gap: 40px; }
    .main-col { flex: 1; min-width: 0; }
    .sidebar { width: 280px; flex-shrink: 0; }
    .widget { margin-bottom: 28px; }
    .widget-title { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
    .category-list { list-style: none; padding: 0; margin: 0; }
    .category-list li { padding: 6px 0; border-bottom: 1px solid #f3f4f6; display: flex; justify-content: space-between; align-items: center; }
    .category-list li:last-child { border: none; }
    .category-list a { color: var(--text); text-decoration: none; font-size: 0.875rem; }
    .category-list a:hover { color: var(--accent); }
    .cat-count { font-size: 0.75rem; color: var(--muted); background: var(--surface); padding: 1px 7px; border-radius: 10px; }

    /* Pagination */
    .pagination-wrap { margin-top: 36px; display: flex; justify-content: center; gap: 6px; }
    .page-btn {
      padding: 7px 14px; border: 1px solid var(--border); border-radius: 7px;
      text-decoration: none; font-size: 0.875rem; color: var(--text); background: #fff;
      transition: all 0.15s;
    }
    .page-btn:hover, .page-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }

    /* Footer */
    .site-footer {
      border-top: 1px solid var(--border); padding: 24px;
      text-align: center; color: var(--muted); font-size: 0.82rem;
    }

    @media (max-width: 768px) {
      .hero-card { flex-direction: column; }
      .hero-image { width: 100%; min-height: 200px; }
      .layout { flex-direction: column; }
      .sidebar { width: 100%; }
      .posts-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<!-- Header -->
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-name"><%= siteTitle || 'MyCMS' %></a>
    <nav class="site-nav">
      <a href="/">Inicio</a>
      <% if (navPages && navPages.length > 0) { %>
        <% navPages.forEach(p => { %><a href="/page/<%= p.slug %>"><%= p.title %></a><% }) %>
      <% } %>
    </nav>
    <form class="search-form" action="/buscar" method="GET">
      <input class="search-input" type="text" name="q" placeholder="Buscar…">
      <button class="search-btn" type="submit"><i class="bi bi-search"></i></button>
    </form>
  </div>
</header>

<% if (posts && posts.length > 0) { %>
  <!-- Hero: first post -->
  <% const hero = posts[0]; const rest = posts.slice(1); %>
  <div class="hero">
    <div class="hero-card">
      <div class="hero-image">
        <% if (hero.featured_image) { %>
          <img src="<%= hero.featured_image %>" alt="<%= hero.title %>">
        <% } else { %>
          <div class="hero-image-placeholder"><i class="bi bi-image"></i></div>
        <% } %>
      </div>
      <div class="hero-body">
        <div class="hero-meta">
          <i class="bi bi-calendar3"></i> <%= new Date(hero.created_at).toLocaleDateString('es-ES', {day:'numeric',month:'long',year:'numeric'}) %>
          <% if (hero.username) { %> · <i class="bi bi-person"></i> <%= hero.username %><% } %>
        </div>
        <a href="/post/<%= hero.slug %>" class="hero-title"><%= hero.title %></a>
        <% if (hero.excerpt) { %><p class="hero-excerpt"><%= hero.excerpt %></p><% } %>
        <a href="/post/<%= hero.slug %>" class="read-more">Leer artículo <i class="bi bi-arrow-right"></i></a>
      </div>
    </div>
  </div>

  <!-- Rest of posts + sidebar -->
  <% if (rest.length > 0) { %>
  <div class="layout" style="margin-top:48px;">
    <div class="main-col">
      <div class="section-label">Entradas recientes</div>
      <div class="posts-grid">
        <% rest.forEach(post => { %>
        <article class="post-card">
          <div class="post-card-image">
            <% if (post.featured_image) { %>
              <img src="<%= post.featured_image %>" alt="<%= post.title %>">
            <% } else { %>
              <div class="post-card-image-placeholder"><i class="bi bi-file-earmark-text"></i></div>
            <% } %>
          </div>
          <div class="post-card-body">
            <div class="post-card-meta">
              <%= new Date(post.created_at).toLocaleDateString('es-ES', {day:'numeric',month:'short',year:'numeric'}) %>
              <% if (post.username) { %> · <%= post.username %><% } %>
            </div>
            <a href="/post/<%= post.slug %>" class="post-card-title"><%= post.title %></a>
            <% if (post.excerpt) { %><p class="post-card-excerpt"><%= post.excerpt.substring(0,100) %>…</p><% } %>
          </div>
        </article>
        <% }) %>
      </div>

      <!-- Pagination -->
      <% if (pages > 1) { %>
      <div class="pagination-wrap">
        <% if (page > 1) { %><a href="/?page=<%= page-1 %>" class="page-btn"><i class="bi bi-chevron-left"></i></a><% } %>
        <% for(let i=1;i<=pages;i++) { %><a href="/?page=<%= i %>" class="page-btn <%= i===page?'active':'' %>"><%= i %></a><% } %>
        <% if (page < pages) { %><a href="/?page=<%= page+1 %>" class="page-btn"><i class="bi bi-chevron-right"></i></a><% } %>
      </div>
      <% } %>
    </div>

    <!-- Sidebar -->
    <aside class="sidebar">
      <% if (categories && categories.length > 0) { %>
      <div class="widget">
        <div class="widget-title">Categorías</div>
        <ul class="category-list">
          <% categories.forEach(cat => { %>
          <li>
            <a href="/?category=<%= cat.slug %>"><%= cat.name %></a>
            <span class="cat-count"><%= cat.count %></span>
          </li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <div class="widget">
        <div class="widget-title">Acerca de</div>
        <p style="font-size:0.875rem;color:#6b7280;line-height:1.65;"><%= siteDescription || 'Bienvenido a ' + siteTitle %></p>
      </div>
    </aside>
  </div>
  <% } %>

<% } else { %>
  <div style="text-align:center;padding:80px 24px;color:#9ca3af;">
    <i class="bi bi-file-earmark-text" style="font-size:3rem;display:block;margin-bottom:14px;"></i>
    <p style="font-size:1.1rem;">Todavía no hay entradas publicadas.</p>
    <a href="/admin" style="color:#6366f1;font-weight:600;">Ir al panel de administración</a>
  </div>
<% } %>

<footer class="site-footer">
  <%= siteTitle || 'MyCMS' %> · Hecho con MyCMS
  <span style="margin-left:14px;"><a href="/admin" style="color:#9ca3af;text-decoration:none;">Admin</a></span>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
