<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Búsqueda: <%= q %> · <%= siteTitle || 'MyCMS' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Lato:wght@400;700&family=Merriweather:wght@400;700&family=Playfair+Display:wght@400;700&family=Roboto:wght@400;500;700&family=Nunito:wght@400;600;700&family=Oswald:wght@400;500;600;700&family=Source+Serif+4:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root { --accent: <%= theme_color || '#6366f1' %>; --text: <%= theme_text_color || '#111827' %>; --muted: rgba(0,0,0,0.55); --border: #e5e7eb; --surface: <%= theme_bg || '#ffffff' %>; }
    body { font-family: '<%= theme_font || 'DM Sans' %>', sans-serif; color: var(--text); margin: 0; background: var(--surface); }
    .site-header { border-bottom: 1px solid var(--border); position: sticky; top: 0; background: rgba(255,255,255,0.95); backdrop-filter: blur(8px); z-index: 100; }
    .header-inner { max-width: 1100px; margin: 0 auto; padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    .site-name { font-size: 1.15rem; font-weight: 700; color: var(--text); text-decoration: none; }
    .site-nav a { color: var(--muted); text-decoration: none; font-size: 0.875rem; font-weight: 500; padding: 5px 10px; border-radius: 6px; }
    .site-nav a:hover { color: var(--text); background: var(--surface); }
    .search-form { display: flex; gap: 6px; }
    .search-input { border: 1px solid var(--border); border-radius: 7px; padding: 6px 12px; font-size: 0.85rem; font-family: inherit; outline: none; width: 200px; }
    .search-input:focus { border-color: var(--accent); }
    .search-btn { background: var(--accent); color: white; border: none; border-radius: 7px; padding: 6px 14px; cursor: pointer; }

    .search-wrap { max-width: 760px; margin: 48px auto 72px; padding: 0 24px; }
    .search-heading { font-family: 'DM Serif Display', serif; font-size: 1.8rem; margin-bottom: 6px; }
    .search-count { color: var(--muted); font-size: 0.875rem; margin-bottom: 32px; }

    /* New search bar in results */
    .search-bar-wrap { margin-bottom: 36px; }
    .search-bar { display: flex; gap: 8px; }
    .search-bar input {
      flex: 1; border: 1px solid var(--border); border-radius: 9px;
      padding: 10px 16px; font-size: 0.95rem; font-family: inherit; outline: none;
    }
    .search-bar input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
    .search-bar button {
      background: var(--accent); color: white; border: none;
      border-radius: 9px; padding: 10px 20px; cursor: pointer; font-size: 0.9rem; font-weight: 500;
    }

    /* Result items */
    .result-item { padding: 22px 0; border-bottom: 1px solid var(--border); }
    .result-item:first-child { padding-top: 0; }
    .result-item:last-child { border: none; }
    .result-title { font-size: 1.1rem; font-weight: 600; margin-bottom: 6px; }
    .result-title a { color: var(--text); text-decoration: none; }
    .result-title a:hover { color: var(--accent); }
    .result-meta { font-size: 0.78rem; color: var(--muted); margin-bottom: 8px; }
    .result-excerpt { font-size: 0.9rem; color: #4b5563; line-height: 1.65; }

    /* No results */
    .no-results { text-align: center; padding: 48px 0; color: var(--muted); }
    .no-results i { font-size: 3rem; display: block; margin-bottom: 14px; }
    .no-results p { font-size: 1rem; }

    .site-footer { border-top: 1px solid var(--border); padding: 24px; text-align: center; color: var(--muted); font-size: 0.82rem; }
  </style>
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-name"><%= siteTitle || 'MyCMS' %></a>
    <nav class="site-nav" style="display:flex;gap:4px;">
      <a href="/">Inicio</a>
      <% if (navPages && navPages.length > 0) { %>
        <% navPages.forEach(p => { %><a href="/page/<%= p.slug %>"><%= p.title %></a><% }) %>
      <% } %>
    </nav>
    <form class="search-form" action="/buscar" method="GET">
      <input class="search-input" type="text" name="q" value="<%= q %>" placeholder="Buscar…">
      <button class="search-btn" type="submit"><i class="bi bi-search"></i></button>
    </form>
  </div>
</header>

<div class="search-wrap">
  <h1 class="search-heading">Resultados de búsqueda</h1>
  <p class="search-count">
    <% if (q) { %>
      <%= posts.length %> resultado<%= posts.length !== 1 ? 's' : '' %> para <strong>"<%= q %>"</strong>
    <% } else { %>
      Introduce un término para buscar
    <% } %>
  </p>

  <!-- Search bar -->
  <div class="search-bar-wrap">
    <form action="/buscar" method="GET" class="search-bar">
      <input type="text" name="q" value="<%= q %>" placeholder="Buscar entradas…" autofocus>
      <button type="submit"><i class="bi bi-search me-1"></i>Buscar</button>
    </form>
  </div>

  <% if (posts && posts.length > 0) { %>
    <% posts.forEach(post => { %>
    <div class="result-item">
      <div class="result-title">
        <a href="/post/<%= post.slug %>"><%= post.title %></a>
      </div>
      <div class="result-meta">
        <i class="bi bi-calendar3"></i>
        <%= new Date(post.created_at).toLocaleDateString('es-ES', {day:'numeric',month:'long',year:'numeric'}) %>
        <% if (post.username) { %> · <i class="bi bi-person"></i> <%= post.username %><% } %>
        <span style="margin-left:8px;color:#6366f1;font-size:0.75rem;">/post/<%= post.slug %></span>
      </div>
      <% if (post.excerpt) { %>
        <div class="result-excerpt"><%= post.excerpt %></div>
      <% } %>
    </div>
    <% }) %>
  <% } else if (q) { %>
    <div class="no-results">
      <i class="bi bi-search"></i>
      <p>No se encontraron entradas para "<%= q %>".</p>
      <p style="font-size:0.875rem;">Prueba con otro término o <a href="/" style="color:#6366f1;">vuelve al inicio</a>.</p>
    </div>
  <% } %>
</div>

<footer class="site-footer">
  <a href="/" style="color:var(--muted);text-decoration:none;"><%= siteTitle || 'MyCMS' %></a>
  <span style="margin-left:14px;"><a href="/admin" style="color:#d1d5db;text-decoration:none;font-size:0.78rem;">Admin</a></span>
</footer>

</body>
</html>
