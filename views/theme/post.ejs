<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> · <%= siteTitle || 'MyCMS' %></title>
  <meta name="description" content="<%= post.excerpt || siteDescription || '' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Lato:wght@400;700&family=Merriweather:wght@400;700&family=Playfair+Display:wght@400;700&family=Roboto:wght@400;500;700&family=Nunito:wght@400;600;700&family=Oswald:wght@400;500;600;700&family=Source+Serif+4:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root { --accent: <%= theme_color || '#6366f1' %>; --text: <%= theme_text_color || '#111827' %>; --muted: rgba(0,0,0,0.55); --border: #e5e7eb; --surface: <%= theme_bg || '#ffffff' %>; }
    body { font-family: '<%= theme_font || 'DM Sans' %>', sans-serif; color: var(--text); margin: 0; background: var(--surface); }
    .site-header { border-bottom: 1px solid var(--border); position: sticky; top: 0; background: rgba(255,255,255,0.95); backdrop-filter: blur(8px); z-index: 100; }
    .header-inner { max-width: 1100px; margin: 0 auto; padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    .site-name { font-size: 1.15rem; font-weight: 700; color: var(--text); text-decoration: none; letter-spacing: -0.02em; }
    .site-nav { display: flex; gap: 4px; align-items: center; }
    .site-nav a { color: var(--muted); text-decoration: none; font-size: 0.875rem; font-weight: 500; padding: 5px 10px; border-radius: 6px; transition: all 0.15s; }
    .site-nav a:hover { color: var(--text); background: var(--surface); }
    .search-form { display: flex; gap: 6px; }
    .search-input { border: 1px solid var(--border); border-radius: 7px; padding: 6px 12px; font-size: 0.85rem; font-family: inherit; outline: none; width: 160px; }
    .search-input:focus { border-color: var(--accent); }
    .search-btn { background: var(--accent); color: white; border: none; border-radius: 7px; padding: 6px 12px; cursor: pointer; }

    /* Article layout */
    .article-wrap { max-width: 760px; margin: 0 auto; padding: 48px 24px 60px; }
    .breadcrumb-nav { font-size: 0.82rem; color: var(--muted); margin-bottom: 24px; }
    .breadcrumb-nav a { color: var(--muted); text-decoration: none; }
    .breadcrumb-nav a:hover { color: var(--accent); }
    .article-cats { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }
    .cat-badge {
      font-size: 0.72rem; font-weight: 600; padding: 3px 10px; border-radius: 20px;
      background: #ede9fe; color: #6d28d9; text-decoration: none;
    }
    .cat-badge:hover { background: #6366f1; color: white; }
    .article-title {
      font-family: 'DM Serif Display', serif;
      font-size: 2.2rem; line-height: 1.2; margin-bottom: 16px; color: var(--text);
    }
    .article-meta { color: var(--muted); font-size: 0.85rem; margin-bottom: 28px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .article-meta i { margin-right: 3px; }
    .article-featured-image { margin-bottom: 32px; border-radius: 12px; overflow: hidden; }
    .article-featured-image img { width: 100%; height: auto; display: block; max-height: 440px; object-fit: cover; }
    .article-content { font-size: 1rem; line-height: 1.8; color: #1f2937; }
    .article-content h2 { font-size: 1.4rem; font-weight: 700; margin-top: 2em; margin-bottom: 0.6em; }
    .article-content h3 { font-size: 1.15rem; font-weight: 600; margin-top: 1.6em; margin-bottom: 0.5em; }
    .article-content p { margin-bottom: 1.2em; }
    .article-content a { color: var(--accent); }
    .article-content img { max-width: 100%; border-radius: 8px; margin: 1em 0; }
    .article-content blockquote { border-left: 4px solid var(--accent); margin: 1.5em 0; padding: 12px 20px; background: #f5f3ff; border-radius: 0 8px 8px 0; color: #4c1d95; }
    .article-content ul, .article-content ol { padding-left: 1.5em; margin-bottom: 1.2em; }
    .article-content li { margin-bottom: 0.4em; }
    .article-content code { background: #f3f4f6; padding: 2px 6px; border-radius: 4px; font-size: 0.88em; }
    .article-content pre { background: #1e1e2e; color: #cdd6f4; padding: 18px; border-radius: 9px; overflow-x: auto; font-size: 0.88em; line-height: 1.6; margin: 1.2em 0; }

    /* Related posts */
    .related-section { max-width: 1100px; margin: 0 auto 60px; padding: 0 24px; }
    .section-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); padding-bottom: 14px; border-bottom: 1px solid var(--border); margin-bottom: 24px; }
    .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .related-card { border: 1px solid var(--border); border-radius: 10px; padding: 18px; text-decoration: none; color: var(--text); display: block; transition: box-shadow 0.2s; }
    .related-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.07); color: var(--text); }
    .related-title { font-weight: 600; font-size: 0.95rem; margin-bottom: 6px; line-height: 1.35; }
    .related-meta { font-size: 0.78rem; color: var(--muted); }

    .site-footer { border-top: 1px solid var(--border); padding: 24px; text-align: center; color: var(--muted); font-size: 0.82rem; }

    @media (max-width: 600px) {
      .article-title { font-size: 1.6rem; }
      .header-inner { flex-wrap: wrap; }
      .search-form { display: none; }
    }
  </style>
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-name"><%= siteTitle || 'MyCMS' %></a>
    <nav class="site-nav">
      <a href="/">Inicio</a>
      <% if (navPages && navPages.length > 0) { %>
        <% navPages.forEach(p => { %><a href="/page/<%= p.slug %>"><%= p.title %></a><% }) %>
      <% } %>
    </nav>
    <form class="search-form" action="/buscar" method="GET">
      <input class="search-input" type="text" name="q" placeholder="Buscar…">
      <button class="search-btn" type="submit"><i class="bi bi-search"></i></button>
    </form>
  </div>
</header>

<article class="article-wrap">
  <nav class="breadcrumb-nav">
    <a href="/">Inicio</a> <i class="bi bi-chevron-right" style="font-size:0.7rem;"></i> Entradas
  </nav>

  <% if (categories && categories.length > 0) { %>
  <div class="article-cats">
    <% categories.forEach(cat => { %>
      <a href="/?category=<%= cat.slug %>" class="cat-badge"><%= cat.name %></a>
    <% }) %>
  </div>
  <% } %>

  <h1 class="article-title"><%= post.title %></h1>

  <div class="article-meta">
    <span><i class="bi bi-calendar3"></i><%= new Date(post.created_at).toLocaleDateString('es-ES', {day:'numeric',month:'long',year:'numeric'}) %></span>
    <% if (post.username) { %><span><i class="bi bi-person"></i><%= post.username %></span><% } %>
  </div>

  <% if (post.featured_image) { %>
  <div class="article-featured-image">
    <img src="<%= post.featured_image %>" alt="<%= post.title %>">
  </div>
  <% } %>

  <div class="article-content"><%- post.content %></div>
</article>

<% if (related && related.length > 0) { %>
<section class="related-section">
  <div class="section-label">También te puede interesar</div>
  <div class="related-grid">
    <% related.forEach(r => { %>
    <a href="/post/<%= r.slug %>" class="related-card">
      <div class="related-title"><%= r.title %></div>
      <div class="related-meta"><%= new Date(r.created_at).toLocaleDateString('es-ES', {day:'numeric',month:'short',year:'numeric'}) %></div>
    </a>
    <% }) %>
  </div>
</section>
<% } %>

<footer class="site-footer">
  <a href="/" style="color:var(--muted);text-decoration:none;"><%= siteTitle || 'MyCMS' %></a>
  <span style="margin-left:14px;"><a href="/admin" style="color:#d1d5db;text-decoration:none;font-size:0.78rem;">Admin</a></span>
</footer>

</body>
</html>
